#!/bin/bash
#PBS -N inc_ms_p2_vor001
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=4
export TEST_INTERVAL=2
export RUN_INITIAL_TEST=0
export BATCH_SIZE=2
export EPOCHS=70
export MAX_TEST_SAMPLES=5
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"
echo "Python: $(which python)"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "EPOCHS=$EPOCHS"
echo "NUM_WORKERS=$NUM_WORKERS"
echo "TEST_INTERVAL=$TEST_INTERVAL"
echo "MAX_TEST_SAMPLES=$MAX_TEST_SAMPLES"

python -c "import torch; print('torch:', torch.__version__); print('cuda:', torch.cuda.is_available()); print('device count:', torch.cuda.device_count()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

# INC_MS_P2_vor001
# C=2, P=2
# lambda_div=0
# lambda_vort=0.01
# THW / temporal modifications OFF
export TEMPORAL_LOSS_WEIGHT=0.0
export USE_CURRICULUM_HORIZON_WEIGHT=0
export HORIZON_T2_WEIGHT=1.0

python src/training_diffusion_inc_multistep_p2_vor001_10h.py

echo "Job finished at: $(date)"
