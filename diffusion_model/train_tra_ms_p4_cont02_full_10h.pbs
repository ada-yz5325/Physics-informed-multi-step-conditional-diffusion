#!/bin/bash
#PBS -N tra_p4x4_c02full
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=16:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=4
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# TRA_MS_P4_cont02_full
#
# TRUE 4 -> 4
# C = 4
# P = 4
#
# Full-block continuity:
#   history_last -> H1
#   H1 -> H2
#   H2 -> H3
#   H3 -> H4
#
# lambda_cont = 0.2
#
# Temporal loss OFF
# Horizon weighting OFF

export CONTINUITY_LOSS_WEIGHT=0.2
export CONTINUITY_DX=1.0
export CONTINUITY_DY=1.0
export CONTINUITY_DT=1.0

export TEMPORAL_LOSS_WEIGHT=0.0
export HORIZON_T2_WEIGHT=1.0

export MULTISTEP_CONT_DIAGNOSTIC=1

echo
echo "========================================"
echo "TRA_MS_P4_cont02_full"
echo "TRUE 4 -> 4"
echo "C = 4"
echo "P = 4"
echo "continuity lambda = $CONTINUITY_LOSS_WEIGHT"
echo "FULL continuity = H1-H4"
echo "temporal loss = OFF"
echo "horizon weighting = OFF"
echo "========================================"

python -c "import torch; print('torch:',torch.__version__); print('cuda:',torch.cuda.is_available()); print('device:',torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

python -m py_compile \
src/training_diffusion_tra_multistep_p4_cont02_full_10h.py \
src/turbpred/trainer_diffusion_tra_fullcont.py \
src/turbpred/model.py \
src/turbpred/model_diffusion.py

python src/training_diffusion_tra_multistep_p4_cont02_full_10h.py

echo "Job finished at: $(date)"
