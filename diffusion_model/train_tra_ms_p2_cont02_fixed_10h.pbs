#!/bin/bash
#PBS -N tra_p2_c02_fix
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=4
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# TRA_MS_P2_cont02_fixed
#
# C = 2
# P = 2
#
# Full multi-step continuity:
#   x_t      -> H1
#   H1       -> H2
#
# lambda_cont = 0.2

export CONTINUITY_LOSS_WEIGHT=0.2
export CONTINUITY_DX=1.0
export CONTINUITY_DY=1.0
export CONTINUITY_DT=1.0

export TEMPORAL_LOSS_WEIGHT=0.0
export HORIZON_T2_WEIGHT=1.0

export MULTISTEP_CONT_DIAGNOSTIC=1

echo
echo "========================================"
echo "TRA_MS_P2_cont02_fixed"
echo "C = 2"
echo "P = 2"
echo "continuity lambda = $CONTINUITY_LOSS_WEIGHT"
echo "continuity applied to H1 + H2"
echo "THW = OFF"
echo "temporal loss = OFF"
echo "========================================"

python -c "import torch; print('cuda:', torch.cuda.is_available()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

python -m py_compile \
src/training_diffusion_tra_multistep_p2_cont02_fixed_10h.py \
src/turbpred/trainer_diffusion.py

python src/training_diffusion_tra_multistep_p2_cont02_fixed_10h.py

echo "Job finished at: $(date)"
