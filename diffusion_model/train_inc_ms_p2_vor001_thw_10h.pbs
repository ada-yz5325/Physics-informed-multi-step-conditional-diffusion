#!/bin/bash
#PBS -N inc_ms_p2_vor001_thw
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=4
export TEST_INTERVAL=2
export RUN_INITIAL_TEST=0
export BATCH_SIZE=2
export EPOCHS=70
export MAX_TEST_SAMPLES=5

# New loss settings
export TEMPORAL_LOSS_WEIGHT=0.01
export HORIZON_T2_WEIGHT=0.5

export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "TEMPORAL_LOSS_WEIGHT=$TEMPORAL_LOSS_WEIGHT"
echo "HORIZON_T2_WEIGHT=$HORIZON_T2_WEIGHT"

python -c "import torch; print('torch:', torch.__version__); print('cuda:', torch.cuda.is_available()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

python src/training_diffusion_inc_multistep_p2_vor001_thw_10h.py

echo "Job finished at: $(date)"
