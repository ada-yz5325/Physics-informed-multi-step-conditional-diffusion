#!/bin/bash
#PBS -N tra_cont02
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"

export EPOCHS=70
export NUM_WORKERS=4
export TEST_INTERVAL=2
export RUN_INITIAL_TEST=0

# Stronger Transonic continuity regularisation
export CONTINUITY_LOSS_WEIGHT=0.2

# Same discrete convention as previous Tra experiment
export CONTINUITY_DX=1.0
export CONTINUITY_DY=1.0
export CONTINUITY_DT=1.0

# Keep unrelated objectives disabled
export TEMPORAL_LOSS_WEIGHT=0.0

# Keep epoch-average diagnostic enabled
export PHYSICS_EPOCH_DIAGNOSTIC=0

export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

echo "===================================="
echo "Transonic continuity training"
echo "lambda_continuity = 0.2"
echo "epochs = 70"
echo "===================================="

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Using python: $(which python)"
python --version

python src/training_diffusion_tra_10h_continuity02.py

echo "Job finished at: $(date)"
