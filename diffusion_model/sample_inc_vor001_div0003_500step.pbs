#!/bin/bash
#PBS -N inc_v001_d003_s500
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=2
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# INC_SS_vor001_div0003
#
# Single-step
# lambda_vort = 0.01
# lambda_div  = 0.003
# 500-step LowRe + HighRe evaluation

export MODEL_PATH="runs/2D_Inc/128_acdm-r20_puv_phys_div003_vort001_10h_00/Model.pth"
export MODEL_LABEL="acdm-r20-puv-vor001-div0003-10h-500step"
export OUT_FOLDER="results/sampling_inc_vor001_div0003_10h_500step"

export ROLLOUT_LENGTH=500
export TEST_FRAME_START=300
export NUM_EVALS=1

# Single-step model
export OUTPUT_HORIZON=1
export REVERSE_STEPS_PER_CALL=20

# Force fresh sampling
export FORCE_RESAMPLE=1

echo
echo "========================================"
echo "INC_SS_vor001_div0003"
echo "lambda_vort = 0.01"
echo "lambda_div  = 0.003"
echo "rollout     = 500"
echo "========================================"
echo "Model: $MODEL_PATH"
echo "Output: $OUT_FOLDER"

echo
echo "Checkpoint:"
ls -lh "$MODEL_PATH"

echo
echo "Python / GPU:"
python -c "import sys; print('python:', sys.executable)"
python -c "import torch; print('torch:', torch.__version__); print('cuda:', torch.cuda.is_available()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

echo
echo "Starting sampling..."
python src/sample_models_inc_with_metrics.py

echo
echo "Job finished at: $(date)"
