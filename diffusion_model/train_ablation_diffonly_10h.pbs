#!/bin/bash
#PBS -N abl_diff
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=10:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

source ./activate_acdm.sh

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"
echo "Python: $(which python)"

python - <<'PY'
import torch
print("torch:", torch.__version__)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())
if torch.cuda.is_available():
    print("device:", torch.cuda.get_device_name(0))
PY

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=4
export TEST_INTERVAL=2
export RUN_INITIAL_TEST=0

export MODEL_NAME=2D_Inc/128_acdm-r20_puv_phys_ablation_diffonly_10h
export REG_DIV=0.0
export REG_VORT=0.0

echo "Ablation setting:"
echo "  MODEL_NAME=${MODEL_NAME}"
echo "  REG_DIV=${REG_DIV}"
echo "  REG_VORT=${REG_VORT}"

python src/training_diffusion_inc_ablation_10h.py

echo "Job finished at: $(date)"
