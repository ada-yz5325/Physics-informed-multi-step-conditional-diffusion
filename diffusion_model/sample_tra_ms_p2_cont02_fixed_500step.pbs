#!/bin/bash
#PBS -N tra_p2_cfix_s500
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

echo "Job started at: $(date)"
echo "Node: $(hostname)"
echo "Working directory: $(pwd)"

source ./activate_acdm.sh

export DATA_ROOT="${DATA_ROOT:-$PROJECT_ROOT/data}"
export NUM_WORKERS=2
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

export MODEL_PATH="runs/2D_Tra/128_acdm-r20_tra_multistep_p2_cont02_fixed_10h_00/Model.pth"
export MODEL_LABEL="acdm-r20-tra-ms-p2-cont02-fixed-10h-500step"
export OUT_FOLDER="results/sampling_tra_ms_p2_cont02_fixed_10h_500step_metrics"

export NUM_EVALS=1
export ROLLOUT_LENGTH=500

export OUTPUT_HORIZON=2
export REVERSE_STEPS_PER_CALL=20

export LOAD_MULTISTEP=1
export LOAD_HISTORY_STEPS=2
export LOAD_FUTURE_STEPS=2

export CONTINUITY_DX=1.0
export CONTINUITY_DY=1.0
export CONTINUITY_DT=1.0

export FORCE_RESAMPLE=1

echo
echo "========================================"
echo "TRA_MS_P2_cont02_fixed 500-step sampling"
echo "========================================"
echo "Model:               $MODEL_PATH"
echo "Output folder:       $OUT_FOLDER"
echo "History C:           $LOAD_HISTORY_STEPS"
echo "Output horizon P:    $OUTPUT_HORIZON"
echo "Rollout length:      $ROLLOUT_LENGTH"
echo "Reverse steps/call:  $REVERSE_STEPS_PER_CALL"
echo "========================================"

echo
echo "Checkpoint:"
ls -lh "$MODEL_PATH"

echo
echo "Python / GPU:"
python -c "import sys; print('python:', sys.executable)"
python -c "import torch; print('torch:', torch.__version__); print('cuda:', torch.cuda.is_available()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"

echo
echo "Starting sampling..."
python src/sample_models_tra_10h.py

echo
echo "Job finished at: $(date)"
